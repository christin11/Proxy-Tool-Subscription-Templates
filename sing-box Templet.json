{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
  "servers": [
    { "tag": "default-dns",     "type": "udp",   "server": "223.5.5.5" },
    { "tag": "default-dns-2",   "type": "udp",   "server": "119.29.29.29" },
    { "tag": "doh-ali",         "type": "https", "server": "223.5.5.5" },
    { "tag": "doh-tencent",     "type": "https", "server": "119.29.29.29" },
    { "tag": "doh-cloudflare",  "type": "https", "server": "dns.cloudflare.com" }
  ],
  "rules": [
    {
      "domain_suffix": ["lan", "local"],
      "server": "default-dns"
    },
    {
      "domain_suffix": [
        "stun.*.*", "stun.*.*.*",
        "msftncsi.com", "msftconnecttest.com", "push.apple.com"
      ],
      "server": "default-dns"
    },
    {
      "domain_suffix": [
        "google.com", "googleapis.com", "youtube.com",
        "facebook.com", "twitter.com", "github.com"
      ],
      "server": "doh-cloudflare"
    }
  ],
  "strategy": "prefer_ipv4"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "secret": "",
      "external_ui": "ui"
    }
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7893
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": 7891
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "redir",
      "tag": "redir-in",
      "listen": "::",
      "listen_port": 7892
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 7894
    }
