{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "default-dns",
        "address": "223.5.5.5"
      },
      {
        "tag": "default-dns-2",
        "address": "119.29.29.29"
      },
      {
        "tag": "doh-ali",
        "address": "https://223.5.5.5/dns-query"
      },
      {
        "tag": "doh-tencent",
        "address": "https://119.29.29.29/dns-query"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "lan",
          "local"
        ],
        "server": "default-dns"
      },
      {
        "domain_suffix": [
          "stun.*.*",
          "stun.*.*.*",
          "msftncsi.com",
          "msftconnecttest.com",
          "push.apple.com"
        ],
        "server": "default-dns"
      },
      {
        "domain_suffix": [
          "google.com",
          "googleapis.com",
          "youtube.com",
          "facebook.com",
          "twitter.com",
          "github.com"
        ],
        "server": "https://dns.cloudflare.com/dns-query"
      }
    ],
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "independent_cache": true,
    "reverse_mapping": false,
    "fakeip": {
      "enabled": false,
      "inet4_range": "198.18.0.1/16"
    }
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "secret": "",
      "external_ui": "ui"
    }
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7893
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": 7891
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "redir",
      "tag": "redir-in",
      "listen": "::",
      "listen_port": 7892
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 7894
    }
  ],
