{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      { "tag": "dns_proxy", "address": "https://8.8.8.8/dns-query", "detour": "🚀 节点选择" },
      { "tag": "dns_direct", "address": "https://223.5.5.5/dns-query", "detour": "DIRECT" },
      { "tag": "dns_block", "address": "rcode://success" }
    ],
    "rules": [
      { "outbound": "any", "server": "dns_direct" },
      { "clash_mode": "Direct", "server": "dns_direct" },
      { "clash_mode": "Global", "server": "dns_proxy" },
      { "rule_set": "geosite-category-ads-all", "server": "dns_block" },
      { "rule_set": ["geosite-geolocation-!cn", "geosite-gfw"], "server": "dns_proxy" },
      { "rule_set": "geosite-cn", "server": "dns_direct" }
    ],
    "final": "dns_proxy",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "inet4_address": "172.19.0.1/30",
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "sniff": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890,
      "sniff": true
    }
  ],
  "outbounds": [
    // 1. 🚀 节点选择 (手动选择)
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "outbounds": ["⚡ 自动选择", "DIRECT", ""]
    },
    // 2. ⚡ 自动选择 (URL-Test 延迟测试)
    {
      "type": "urltest",
      "tag": "⚡ 自动选择",
      "outbounds": ["你的订阅链接"],
      "url": " https://www.epochtimes.com",
      "interval": "3m",
      "tolerance": 50
    },
    // 3. 🎬 国际媒体
    {
      "type": "selector",
      "tag": "🎬 国际媒体",
      "outbounds": ["🚀 节点选择", "你的订阅链接", "DIRECT"]
    },
    // 4. 🎨 谷歌服务
    {
      "type": "selector",
      "tag": "🎨 谷歌服务",
      "outbounds": ["🚀 节点选择", "DIRECT"]
    },
    // 5. 🍎 苹果服务
    {
      "type": "selector",
      "tag": "🍎 苹果服务",
      "outbounds": ["DIRECT", "🚀 节点选择"]
    },
    // 6. 🛑 广告拦截
    {
      "type": "selector",
      "tag": "🛑 广告拦截",
      "outbounds": ["REJECT", "DIRECT"]
    },
    // 基础出站
    { "type": "direct", "tag": "DIRECT" },
    { "type": "block", "tag": "REJECT" },
    { "type": "dns", "tag": "dns-out" }
  ],
  "route": {
    "rules": [
      { "protocol": "dns", "outbound": "dns-out" },
      { "clash_mode": "Direct", "outbound": "DIRECT" },
      { "clash_mode": "Global", "outbound": "🚀 节点选择" },
      // 路由分流规则集映射
      { "rule_set": "geosite-category-ads-all", "outbound": "🛑 广告拦截" },
      { "rule_set": ["geosite-netflix", "geosite-disney", "geosite-youtube"], "outbound": "🎬 国际媒体" },
      { "rule_set": "geosite-google", "outbound": "🎨 谷歌服务" },
      { "rule_set": "geosite-apple", "outbound": "🍎 苹果服务" },
      { "rule_set": ["geosite-geolocation-!cn", "geosite-gfw"], "outbound": "🚀 节点选择" },
      { "rule_set": ["geosite-cn", "geoip-cn"], "outbound": "DIRECT" }
    ],
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-category-ads-all.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-netflix",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-netflix.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-disney",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-disney.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-youtube.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-google.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-apple",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-apple.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-geolocation-!cn.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-gfw",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-gfw.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geosite-cn.srs",
        "download_detour": "🚀 节点选择"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set/geoip-cn.srs",
        "download_detour": "🚀 节点选择"
      }
    ],
    "final": "🚀 节点选择",
    "auto_detect_interface": true
  }
}
