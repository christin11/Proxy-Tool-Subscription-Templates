// Sub-Store 脚本操作：适配 christin11/Subscription-Templet 最新版 sing-box 模板
// （这份模板的地区分组用 "DIRECT" 作为永久兜底成员，脚本只做"追加"，不做"替换/清空"）
//
// URL 参数（脚本链接后面用 # 拼接）：
//   name = 你在 Sub-Store 里保存的订阅名称（必填）
//   type = 0 单条订阅 / 1 组合订阅（默认 0）
// 例：#name=my_airport&type=0

log(`🚀 开始合并节点`)

let { name, type } = $arguments
if (!name) {
  throw new Error('缺少参数 name：请在脚本参数里指定 Sub-Store 中的订阅名称')
}
type = /^1$/.test(type) ? 'collection' : 'subscription'

// ① 解析当前模板内容
const parser = ProxyUtils.JSON5 || JSON
let config
try {
  config = parser.parse($content ?? $files[0])
} catch (e) {
  throw new Error(`模板不是合法的 JSON: ${e.message ?? e}`)
}

// ② 读取订阅，转换为 sing-box 节点
log(`② 读取订阅 [${name}] (${type})`)
let data = await produceArtifact({
  name,
  type,
  platform: 'sing-box',
})
data = JSON.parse(data)
const proxies = [...(data.outbounds ?? []), ...(data.endpoints ?? [])]
log(`获取到 ${proxies.length} 个节点`)

if (proxies.length === 0) {
  throw new Error('订阅没有解析出任何节点，请检查订阅名称/类型是否填写正确')
}

// ③ 地区分组 tag -> 节点名筛选正则
const REGION_RULES = [
  ['🇭🇰 香港节点', /🇭🇰|香港|港|\bHK\b|Hong/i],
  ['🇹🇼 台湾节点', /🇹🇼|台湾|台灣|台|\bTW\b|Taiwan/i],
  ['🇯🇵 日本节点', /🇯🇵|日本|东京|東京|\bJP\b|Japan/i],
  ['🇰🇷 韩国节点', /🇰🇷|韩|韓|首尔|\bKR\b|Korea/i],
  ['🇸🇬 新加坡节点', /🇸🇬|新加坡|狮|狮城|\bSG\b|Singapore/i],
  ['🇹🇭 泰国节点', /🇹🇭|泰国|泰國|曼谷|\bTH\b|Thailand/i],
  ['🇺🇸 美国节点', /🇺🇸|美国|洛杉矶|圣何塞|\bUS\b|States|America/i],
  ['🇩🇪 德国节点', /🇩🇪|德国|德國|\bDE\b|Germany/i],
  ['🇬🇧 英国节点', /🇬🇧|英国|英國|GBR|\bUK\b(?!R)|Kingdom/i],
]

// ④ 手动切换/自动选择/故障转移/负载均衡 这几个「全量节点池」分组，同样只追加不清空
const FULL_POOL_TAGS = ['🚀 手动切换', '♻️ 自动选择', '🔯 故障转移', '🔮 负载均衡']
// 注：🚀 手动切换 原本 outbounds 是 ["✨ 节点选择", "DIRECT"]，
// 会跟 ✨ 节点选择 形成循环引用（✨ 节点选择 -> 🚀 手动切换 -> ✨ 节点选择）。
// 脚本会把真实节点追加进去，但你仍需手动把模板里 🚀 手动切换 的
// "✨ 节点选择" 这一项删掉，只留 "DIRECT"，避免循环引用报错。

if (!Array.isArray(config.outbounds)) config.outbounds = []

let regionMatched = 0
let poolMatched = 0

config.outbounds.forEach(ob => {
  if (!Array.isArray(ob.outbounds)) return

  const regionRule = REGION_RULES.find(([tag]) => tag === ob.tag)
  if (regionRule) {
    const [, regex] = regionRule
    const tags = proxies.filter(p => regex.test(p.tag)).map(p => p.tag)
    // 只追加，不删除原有的 "DIRECT"，即使 tags 为空也不会导致数组变空
    ob.outbounds.push(...tags)
    log(`🕳 ${ob.tag} 追加 ${tags.length} 个节点${tags.length === 0 ? '（该地区无匹配节点，保留 DIRECT 兜底）' : ''}`)
    regionMatched++
    return
  }

  if (FULL_POOL_TAGS.includes(ob.tag)) {
    const tags = proxies.map(p => p.tag)
    ob.outbounds.push(...tags)
    log(`🕳 ${ob.tag} 追加 ${tags.length} 个节点（全量）`)
    poolMatched++
  }
})

log(`③ 地区分组处理 ${regionMatched} 个，全量池处理 ${poolMatched} 个`)

// ⑤ 把真实节点对象本身加进 outbounds 数组末尾
config.outbounds.push(...proxies)

$content = JSON.stringify(config, null, 2)
log(`🔚 完成`)

function log(v) {
  console.log(`[merge_nodes_v3] ${v}`)
}
